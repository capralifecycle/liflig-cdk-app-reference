{
  "name": "infrastructure",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "scripts": {
    "cdk": "cdk",
    "fetch-variables": "fetch-pipeline-variables",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "format": "biome format --write",
    "snapshots": "rm -rf cdk.out __snapshots__ && IS_SNAPSHOT=true cdk synth && cdk-create-snapshots",
    "upgrade-dependencies": "ncu --upgrade --install always --format group --reject @types/node"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "24.13.3",
    "aws-cdk": "2.1136.0",
    "npm-check-updates": "23.0.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@capraconsulting/webapp-deploy-lambda": "2.5.153",
    "@liflig/cdk": "3.28.2",
    "aws-cdk-lib": "2.264.0",
    "constructs": "10.8.1"
  }
}
